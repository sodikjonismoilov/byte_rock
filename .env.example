# SignSafe environment — copy to .env.local and fill in locally. NEVER commit .env.local.

# Meterless Nightshift (the phone line — every LLM call goes through here)
NIGHTSHIFT_BASE_URL=
NIGHTSHIFT_API_KEY=

# NVIDIA (key goes in Nightshift's Providers tab, NOT in code)
NVIDIA_API_KEY=

# Zetaris (the records room)
ZETARIS_URL=
ZETARIS_API_KEY=
# The restored UI-proxy scripts load .env.local (gitignored), not .env.
# ZETARIS_URL above is a legacy placeholder; the connector uses BASE_URL below.
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Optional: omit to use the server's default engine.
ZETARIS_ENGINE_ID=

# Run mode: true = fake adapters + cold-case files, no services needed
SAMPLE_MODE=false

# Legal model configuration: keep real values only in ignored .env.local.
# Choose one provider explicitly; missing settings stop model mode.
LLM_PROVIDER=
NIGHTSHIFT_MODEL=
# Direct NVIDIA inference is optional; prefer the team's Nightshift provider.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
# Aggregate legal investigation budgets.
INVESTIGATION_TIMEOUT=300
INVESTIGATION_MAX_TOOL_CALLS=160
LEGAL_MAX_MODEL_CALLS=9
LEGAL_MAX_REVISIONS=2
LLM_TIMEOUT=30
LEGAL_CONTEXT_MAX_BYTES=40000
LEGAL_CONTEXT_MAX_TOKENS=16000
LEGAL_MODEL_PAYLOAD_MAX_BYTES=64000
LEGAL_MODEL_MAX_TOKENS=32000

# Meterless Runtime v4: select explicitly with LLM_PROVIDER=meterless.
# NIGHTSHIFT_* above remains a legacy alias for the same runtime contract.
METERLESS_BASE_URL=
METERLESS_MODEL=
METERLESS_RUNTIME_TOKEN=
# Optional: read the real token from this runtime state directory's proxy-token.
METERLESS_STATE_DIR=
# Provider preferences are saved privately under .local/meterless.json using
# the key meterless_runtime_token. Never put a connect link on a command line.

# Optional persistent legal-local H-MEM; keep this directory private/ignored.
LEGAL_MEMORY_DIR=
