{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "complaint",
        "confirmed_violation",
        "tenant_report",
        "other",
        "inspection",
        "permit",
        "case_filing",
        "decision",
        "judgment",
        "warrant",
        "executed_eviction"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "Finding": {
      "properties": {
        "memory_ids": {
          "description": "Context influences only; claims must cite evidence and legal authorities separately",
          "items": {
            "description": "H-MEM context ID only; cannot support factual or legal conclusions",
            "pattern": "^mem-[0-9]+$",
            "type": "string"
          },
          "title": "Memory Ids",
          "type": "array"
        },
        "supported_facts": {
          "items": {
            "type": "string"
          },
          "title": "Supported Facts",
          "type": "array"
        },
        "contradictory_evidence_ids": {
          "items": {
            "description": "Exact ID from accepted evidence registry; never an authority or mem-* ID",
            "type": "string"
          },
          "title": "Contradictory Evidence Ids",
          "type": "array"
        },
        "missing_information": {
          "items": {
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        },
        "sufficiency": {
          "default": "partial",
          "enum": [
            "sufficient",
            "partial",
            "insufficient"
          ],
          "title": "Sufficiency",
          "type": "string"
        },
        "follow_up_tasks": {
          "items": {
            "type": "string"
          },
          "title": "Follow Up Tasks",
          "type": "array"
        },
        "valid": {
          "default": true,
          "title": "Valid",
          "type": "boolean"
        },
        "interpretation_type": {
          "default": "research_interpretation",
          "title": "Interpretation Type",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "issue": {
          "title": "Issue",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "description": "Exact ID from accepted evidence registry; never an authority or mem-* ID",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_kinds": {
          "items": {
            "$ref": "#/$defs/EvidenceKind"
          },
          "title": "Evidence Kinds",
          "type": "array"
        },
        "legal_conclusions": {
          "items": {
            "$ref": "#/$defs/LegalConclusion"
          },
          "title": "Legal Conclusions",
          "type": "array"
        },
        "confidence": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "treats_complaint_as_violation": {
          "default": false,
          "title": "Treats Complaint As Violation",
          "type": "boolean"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "issue",
        "summary"
      ],
      "title": "Finding",
      "type": "object"
    },
    "LegalConclusion": {
      "properties": {
        "claim_scope": {
          "default": "historical_application",
          "enum": [
            "current_guidance",
            "statute_text",
            "historical_application"
          ],
          "title": "Claim Scope",
          "type": "string"
        },
        "support_quotes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Support Quotes",
          "type": "object"
        },
        "citations": {
          "description": "Runtime-grounded metadata; never trusted from model output",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Citations",
          "type": "array"
        },
        "grounding_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grounding Version"
        },
        "grounding_errors": {
          "items": {
            "type": "string"
          },
          "title": "Grounding Errors",
          "type": "array"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "description": "Exact retrieved legal catalog authority ID; never evidence or mem-* IDs",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "identifiers": {
          "items": {
            "type": "string"
          },
          "title": "Identifiers",
          "type": "array"
        },
        "supported": {
          "default": true,
          "title": "Supported",
          "type": "boolean"
        }
      },
      "required": [
        "statement"
      ],
      "title": "LegalConclusion",
      "type": "object"
    },
    "LegalSource": {
      "properties": {
        "authority_type": {
          "default": "agency_guidance",
          "enum": [
            "statute",
            "agency_guidance",
            "court_guidance",
            "judicial_decision"
          ],
          "title": "Authority Type",
          "type": "string"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        },
        "checked_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked On"
        },
        "temporal_limitations": {
          "default": "Effective version must be checked for the incident date.",
          "title": "Temporal Limitations",
          "type": "string"
        },
        "id": {
          "description": "Exact retrieved legal catalog authority ID; never evidence or mem-* IDs",
          "title": "Id",
          "type": "string"
        },
        "excerpt_provenance": {
          "additionalProperties": true,
          "title": "Excerpt Provenance",
          "type": "object"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "jurisdiction": {
          "title": "Jurisdiction",
          "type": "string"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        }
      },
      "required": [
        "id",
        "title",
        "jurisdiction",
        "identifier",
        "url",
        "summary"
      ],
      "title": "LegalSource",
      "type": "object"
    },
    "LegalSourceHit": {
      "properties": {
        "source": {
          "$ref": "#/$defs/LegalSource"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "matched_terms": {
          "items": {
            "type": "string"
          },
          "title": "Matched Terms",
          "type": "array"
        }
      },
      "required": [
        "source",
        "score"
      ],
      "title": "LegalSourceHit",
      "type": "object"
    }
  },
  "properties": {
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "plan_revision": {
      "title": "Plan Revision",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "retrieved_sources": {
      "items": {
        "$ref": "#/$defs/LegalSourceHit"
      },
      "title": "Retrieved Sources",
      "type": "array"
    },
    "evidence_ids_used": {
      "items": {
        "description": "Exact ID from accepted evidence registry; never an authority or mem-* ID",
        "type": "string"
      },
      "title": "Evidence Ids Used",
      "type": "array"
    },
    "reasoning_mode": {
      "default": "demo_deterministic",
      "title": "Reasoning Mode",
      "type": "string"
    },
    "caveats": {
      "items": {
        "type": "string"
      },
      "title": "Caveats",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "plan_revision",
    "findings"
  ],
  "title": "ResearchDraft",
  "type": "object"
}
