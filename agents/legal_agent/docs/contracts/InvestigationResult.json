{
  "$defs": {
    "BuildingInfo": {
      "properties": {
        "address": {
          "title": "Address",
          "type": "string"
        },
        "borough": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Borough"
        },
        "bin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bin"
        },
        "bbl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbl"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "year_built": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year Built"
        },
        "residential_units": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residential Units"
        }
      },
      "required": [
        "address"
      ],
      "title": "BuildingInfo",
      "type": "object"
    },
    "CriticIssue": {
      "properties": {
        "memory_ids": {
          "items": {
            "description": "H-MEM context ID only; cannot support factual or legal conclusions",
            "pattern": "^mem-[0-9]+$",
            "type": "string"
          },
          "title": "Memory Ids",
          "type": "array"
        },
        "recoverable": {
          "default": false,
          "title": "Recoverable",
          "type": "boolean"
        },
        "follow_up_query": {
          "anyOf": [
            {
              "maxLength": 3000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Follow Up Query"
        },
        "evidence_ids": {
          "items": {
            "description": "Exact ID from accepted evidence registry; never an authority or mem-* ID",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "required_correction": {
          "default": "Recheck affected evidence and retrieve supporting authority.",
          "title": "Required Correction",
          "type": "string"
        },
        "recommended_agent_or_tool": {
          "default": "legal_search",
          "title": "Recommended Agent Or Tool",
          "type": "string"
        },
        "priority": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "CriticIssue",
      "type": "object"
    },
    "CriticOutcome": {
      "enum": [
        "BLOCKED",
        "PASS",
        "REVISE",
        "INCONCLUSIVE"
      ],
      "title": "CriticOutcome",
      "type": "string"
    },
    "CriticReport": {
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/CriticOutcome"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/CriticIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "revision_instructions": {
          "items": {
            "type": "string"
          },
          "title": "Revision Instructions",
          "type": "array"
        },
        "reasoning_mode": {
          "default": "demo_deterministic",
          "title": "Reasoning Mode",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "outcome"
      ],
      "title": "CriticReport",
      "type": "object"
    },
    "EvidenceConflict": {
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "category",
        "evidence_ids",
        "explanation"
      ],
      "title": "EvidenceConflict",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "complaint",
        "confirmed_violation",
        "tenant_report",
        "other",
        "inspection",
        "permit",
        "case_filing",
        "decision",
        "judgment",
        "warrant",
        "executed_eviction"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "Finding": {
      "properties": {
        "memory_ids": {
          "description": "Context influences only; claims must cite evidence and legal authorities separately",
          "items": {
            "description": "H-MEM context ID only; cannot support factual or legal conclusions",
            "pattern": "^mem-[0-9]+$",
            "type": "string"
          },
          "title": "Memory Ids",
          "type": "array"
        },
        "supported_facts": {
          "items": {
            "type": "string"
          },
          "title": "Supported Facts",
          "type": "array"
        },
        "contradictory_evidence_ids": {
          "items": {
            "description": "Exact ID from accepted evidence registry; never an authority or mem-* ID",
            "type": "string"
          },
          "title": "Contradictory Evidence Ids",
          "type": "array"
        },
        "missing_information": {
          "items": {
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        },
        "sufficiency": {
          "default": "partial",
          "enum": [
            "sufficient",
            "partial",
            "insufficient"
          ],
          "title": "Sufficiency",
          "type": "string"
        },
        "follow_up_tasks": {
          "items": {
            "type": "string"
          },
          "title": "Follow Up Tasks",
          "type": "array"
        },
        "valid": {
          "default": true,
          "title": "Valid",
          "type": "boolean"
        },
        "interpretation_type": {
          "default": "research_interpretation",
          "title": "Interpretation Type",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "issue": {
          "title": "Issue",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "description": "Exact ID from accepted evidence registry; never an authority or mem-* ID",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_kinds": {
          "items": {
            "$ref": "#/$defs/EvidenceKind"
          },
          "title": "Evidence Kinds",
          "type": "array"
        },
        "legal_conclusions": {
          "items": {
            "$ref": "#/$defs/LegalConclusion"
          },
          "title": "Legal Conclusions",
          "type": "array"
        },
        "confidence": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "treats_complaint_as_violation": {
          "default": false,
          "title": "Treats Complaint As Violation",
          "type": "boolean"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "issue",
        "summary"
      ],
      "title": "Finding",
      "type": "object"
    },
    "IdentifierEvidence": {
      "properties": {
        "kind": {
          "enum": [
            "bin",
            "bbl",
            "hpd_building_id"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "authoritative": {
          "default": false,
          "title": "Authoritative",
          "type": "boolean"
        },
        "fictional": {
          "default": false,
          "title": "Fictional",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value",
        "source",
        "record_id"
      ],
      "title": "IdentifierEvidence",
      "type": "object"
    },
    "IdentityCandidate": {
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "borough": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Borough"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "identifiers": {
          "items": {
            "$ref": "#/$defs/IdentifierEvidence"
          },
          "title": "Identifiers",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "address"
      ],
      "title": "IdentityCandidate",
      "type": "object"
    },
    "IdentityResult": {
      "properties": {
        "schema_version": {
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        },
        "canonical_address": {
          "title": "Canonical Address",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "borough": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Borough"
        },
        "identifiers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Identifiers",
          "type": "object"
        },
        "verified_identifiers": {
          "items": {
            "$ref": "#/$defs/IdentifierEvidence"
          },
          "title": "Verified Identifiers",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/IdentityCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "rejected_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Rejected Candidates",
          "type": "array"
        },
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "title": "Ambiguities",
          "type": "array"
        },
        "match_method": {
          "default": "none",
          "title": "Match Method",
          "type": "string"
        },
        "confidence": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "verification_status": {
          "default": "missing",
          "enum": [
            "verified",
            "sample",
            "unverified",
            "ambiguous",
            "missing"
          ],
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "canonical_address"
      ],
      "title": "IdentityResult",
      "type": "object"
    },
    "InvestigationError": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "InvestigationError",
      "type": "object"
