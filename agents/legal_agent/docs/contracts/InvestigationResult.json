        "support_quotes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Support Quotes",
          "type": "object"
        },
        "citations": {
          "description": "Runtime-grounded metadata; never trusted from model output",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Citations",
          "type": "array"
        },
        "grounding_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grounding Version"
        },
        "grounding_errors": {
          "items": {
            "type": "string"
          },
          "title": "Grounding Errors",
          "type": "array"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "description": "Exact retrieved legal catalog authority ID; never evidence or mem-* IDs",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "identifiers": {
          "items": {
            "type": "string"
          },
          "title": "Identifiers",
          "type": "array"
        },
        "supported": {
          "default": true,
          "title": "Supported",
          "type": "boolean"
        }
      },
      "required": [
        "statement"
      ],
      "title": "LegalConclusion",
      "type": "object"
    },
    "LegalSource": {
      "properties": {
        "authority_type": {
          "default": "agency_guidance",
          "enum": [
            "statute",
            "agency_guidance",
            "court_guidance",
            "judicial_decision"
          ],
          "title": "Authority Type",
          "type": "string"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        },
        "checked_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked On"
        },
        "temporal_limitations": {
          "default": "Effective version must be checked for the incident date.",
          "title": "Temporal Limitations",
          "type": "string"
        },
        "id": {
          "description": "Exact retrieved legal catalog authority ID; never evidence or mem-* IDs",
          "title": "Id",
          "type": "string"
        },
        "excerpt_provenance": {
          "additionalProperties": true,
          "title": "Excerpt Provenance",
          "type": "object"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "jurisdiction": {
          "title": "Jurisdiction",
          "type": "string"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        }
      },
      "required": [
        "id",
        "title",
        "jurisdiction",
        "identifier",
        "url",
        "summary"
      ],
      "title": "LegalSource",
      "type": "object"
    },
    "ReconciliationResult": {
      "properties": {
        "accepted_ids": {
