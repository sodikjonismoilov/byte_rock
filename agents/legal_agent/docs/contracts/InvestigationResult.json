          "type": "string"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "focus_topics": {
          "items": {
            "type": "string"
          },
          "title": "Focus Topics",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "description": "Exact ID from accepted evidence registry; never an authority or mem-* ID",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
