# Offline mode uses rules and fictional property fixtures, not autonomous reasoning.
LLM_PROVIDER=demo

# For a chat-completions-compatible provider (including NVIDIA-hosted inference):
# LLM_PROVIDER=compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=your-model-id
# LLM_API_KEY=              # keep only in environment / ignored .env
# LLM_TIMEOUT=30

# Limits can be lowered; hard ceilings are 2 revisions / 10 research tool calls.
# LEGAL_MAX_REVISIONS=2
# LEGAL_MAX_TOOL_CALLS=10
# LEGAL_TOOL_TIMEOUT=5
# LEGAL_MAX_RETRIES=1
# LEGAL_MAX_MODEL_CALLS=9
